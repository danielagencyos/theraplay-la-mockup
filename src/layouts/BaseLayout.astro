---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "TheraPlay LA — a leading pediatric therapy clinic in Los Angeles specializing in occupational, speech, feeding, and orofacial myofunctional therapy." } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title} | TheraPlay LA</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Nunito+Sans:wght@400;600;700;800&family=Caveat:wght@500;600&display=swap" rel="stylesheet" />
  <link rel="icon" type="image/png" href="/images/logo-theraplay-mobile.png" />
</head>
<body class="bg-white text-dark-light">
  <Header currentPath={Astro.url.pathname} />
  <main>
    <slot />
  </main>
  <Footer />

  <script>
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) entry.target.classList.add('visible');
      });
    }, { threshold: 0.1 });
    document.querySelectorAll('.fade-in-up').forEach(el => observer.observe(el));
  </script>
</body>
</html>
