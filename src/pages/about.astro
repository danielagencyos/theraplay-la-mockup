---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CtaBand from '../components/CtaBand.astro';

const pillars = [
  {
    title: 'Occupational Therapy',
    text: 'Sensory processing, motor foundations, and primitive reflex integration — the base layer of the stack.',
  },
  {
    title: 'Airway-Focused Care',
    text: 'Breathing quality shapes sleep, appetite, attention, and regulation. We screen for it in every child.',
  },
  {
    title: 'Myofunctional Therapy',
    text: 'Retraining tongue posture, chewing, and swallowing patterns so gains in every other area actually hold.',
  },
];

const press = [
  { outlet: 'CBS News Los Angeles', note: 'Nervous system relief for children affected by the LA fires' },
  { outlet: 'Voyage LA', note: 'Interview with Dr. Marielly Mitchell' },
  { outlet: 'ShoutOut LA', note: 'Profile feature' },
  { outlet: 'Untethered Podcast', note: 'Multiple featured episodes' },
  { outlet: 'Brave Together Podcast', note: '"When Breathing Impacts Sensory Issues"' },
  { outlet: 'Autism Dietitian Podcast', note: 'Mouth breathing, picky eating & sleep' },
];
---

<BaseLayout title="About Us" description="The story behind TheraPlay LA — a doctor-led pediatric therapy clinic in Los Angeles built on the Therastacking whole-child approach.">
  <Hero
    compact
    eyebrow="our story"
    title="Care that's intentional, precise & joyful"
    subtitle="TheraPlay LA began as one occupational therapist's conviction that children deserve better than symptom-chasing — and grew into a multidisciplinary clinic families trust across Los Angeles."
    image="/images/space-gym-2.jpg"
  />

  <!-- Founder story -->
  <section class="py-20 bg-white overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-5 gap-14 items-center">
        <div class="lg:col-span-2 relative fade-in-up">
          <div class="absolute -bottom-8 -left-8 w-48 h-48 bg-brand-primary-light/20 blob-soft"></div>
          <img src="/images/team-dr-marielly.jpg" alt="Dr. Marielly Mitchell, OTD, OTR/L — founder of TheraPlay LA" class="relative rounded-3xl shadow-xl w-full max-h-[560px] object-cover object-top" loading="lazy" />
        </div>
        <div class="lg:col-span-3">
          <p class="eyebrow-script mb-2">meet the founder</p>
          <h2 class="text-3xl md:text-4xl font-heading mb-2">Dr. Marielly Mitchell</h2>
          <p class="text-brand-primary font-bold text-sm uppercase tracking-wider mb-6">OTD, OTR/L, SIPT, SWC · Pediatric OT & Orofacial Myofunctional Therapist</p>
          <p class="text-dark-light/85 leading-relaxed mb-4">
            After nearly 13 years working hands-on with children, Dr. Marielly kept seeing the same pattern: kids
            bounced between disconnected specialists — one for speech, one for feeding, one for behavior — while the
            underlying thread connecting their challenges went unnoticed. The picky eater who mouth-breathes. The
            "inattentive" student who never sleeps deeply. The speech delay rooted in oral muscle patterns.
          </p>
          <p class="text-dark-light/85 leading-relaxed mb-4">
            She founded TheraPlay LA to close those gaps, and developed <strong>Therastacking</strong> — her signature
            whole-child method that layers occupational therapy, airway-focused care, and orofacial myofunctional
            therapy to treat root causes rather than chase symptoms.
          </p>
          <p class="text-dark-light/85 leading-relaxed">
            Today the practice she started has grown into a full team spanning OT, speech-language pathology, feeding,
            sleep, and nutrition — serving families in our La Brea clinic and, through teletherapy, far beyond Los Angeles.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Therastacking pillars -->
  <section class="py-20 bg-sky-tint">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <p class="eyebrow-script mb-2">the Therastacking™ method</p>
        <h2 class="text-3xl md:text-4xl font-heading">Three disciplines, one stacked plan</h2>
        <p class="mt-4 text-dark-light/80 leading-relaxed">
          Each layer strengthens the others. That's why families who've "tried everything" often see their first real
          breakthroughs here.
        </p>
      </div>
      <div class="grid md:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {pillars.map((pillar, i) => (
          <div class="card-accent bg-white rounded-2xl p-8 fade-in-up">
            <div class="w-10 h-10 rounded-full bg-brand-secondary/15 text-brand-secondary-dark font-heading flex items-center justify-center mb-4">{i + 1}</div>
            <h3 class="font-heading text-xl text-dark mb-3">{pillar.title}</h3>
            <p class="text-sm text-dark-light/80 leading-relaxed">{pillar.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-14 items-center">
        <div class="order-2 lg:order-1">
          <p class="eyebrow-script mb-2">what we believe</p>
          <h2 class="text-3xl md:text-4xl font-heading mb-6">Every child can become the best version of themselves</h2>
          <div class="space-y-5">
            {[
              { title: 'Root causes over symptoms', text: 'We ask "why" until the answer explains everything — then treat that.' },
              { title: 'Play is the work', text: 'Children learn fastest when they\'re joyful, safe, and moving. Our clinic is built to make hard work feel like the best hour of their week.' },
              { title: 'Parents are partners', text: 'No black-box therapy. You\'ll always know what we\'re working on, why, and how to carry it home.' },
              { title: 'Collaboration by default', text: 'Dentists, ENTs, pediatricians, teachers — we work with your child\'s whole village.' },
            ].map(v => (
              <div class="flex gap-4 fade-in-up">
                <div class="flex-shrink-0 w-9 h-9 rounded-full bg-brand-primary/10 text-brand-primary flex items-center justify-center">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
                </div>
                <div>
                  <h3 class="font-bold text-dark text-base mb-1 font-body">{v.title}</h3>
                  <p class="text-sm text-dark-light/80 leading-relaxed">{v.text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
        <div class="order-1 lg:order-2 grid grid-cols-2 gap-4 fade-in-up">
          <img src="/images/clinic-therapy-3.jpg" alt="Therapy session at TheraPlay LA" class="rounded-2xl shadow-md w-full h-64 object-cover" loading="lazy" />
          <img src="/images/space-gym-4.jpg" alt="TheraPlay LA sensory gym" class="rounded-2xl shadow-md w-full h-64 object-cover mt-8" loading="lazy" />
          <img src="/images/clinic-eval.jpg" alt="Play-based evaluation" class="rounded-2xl shadow-md w-full h-64 object-cover" loading="lazy" />
          <img src="/images/clinic-therapy-5.jpg" alt="Child building skills through play" class="rounded-2xl shadow-md w-full h-64 object-cover mt-8" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- Press -->
  <section class="py-20 bg-light-bg">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <p class="eyebrow-script mb-2">in the press</p>
        <h2 class="text-3xl md:text-4xl font-heading">A voice families & media trust</h2>
        <p class="mt-4 text-dark-light/80">Dr. Marielly is a frequent voice on pediatric development, airway health, and sensory processing.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 max-w-5xl mx-auto">
        {press.map(item => (
          <div class="bg-white rounded-2xl px-6 py-5 border border-sky-tint shadow-sm fade-in-up">
            <div class="font-bold text-dark text-sm">{item.outlet}</div>
            <div class="text-muted text-xs mt-1 leading-relaxed">{item.note}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
